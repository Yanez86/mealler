# Copia in .env e modifica a piacere.

# Porta sul NAS da cui raggiungere Mealler (http://IP-DEL-NAS:3000)
MEALLER_PORT=3000

# Fuso orario del server
TZ=Europe/Rome

# Indirizzo pubblico HTTPS, se Mealler è esposto tramite reverse proxy (facoltativo).
# Esempio: https://mealler.miodominio.it
MEALLER_BASE_URL=

# Solo dietro un reverse proxy o un tunnel: la porta qui sopra risponde solo dal server stesso,
# così nessuno raggiunge Mealler in HTTP semplice scavalcando il proxy.
# MEALLER_BIND=127.0.0.1

# Indirizzi o reti dei proxy di cui Mealler si fida per conoscere l'indirizzo vero di chi si collega
# (limiti sui tentativi di accesso) e sapere di essere in HTTPS. Predefinito: indirizzi privati e locali,
# cioè un proxy sullo stesso server o nella stessa rete Docker. "none" = nessun proxy.
# MEALLER_TRUST_PROXY=

# Chiave che cifra i segreti nel database (es. la chiave API Anthropic). Se vuota, Mealler ne genera una
# nel file secret.key della cartella dati; impostala qui per tenerla fuori da quella cartella e dai suoi backup.
# MEALLER_SECRET_KEY=

# false = non controllare su GitHub se esiste una versione più recente.
# MEALLER_UPDATE_CHECK=true

# LOG_LEVEL=info
